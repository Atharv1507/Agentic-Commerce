VITE_API_BASE_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# The merchant's own service. Used ONLY by the developer-only merchant
# analytics page — all shopping traffic still goes through the Personal Agent
# above.
VITE_SELLER_BASE_URL=http://localhost:8001

# Reads the merchant's analytics. Note this ships in the client bundle and is
# therefore NOT secret — acceptable only because the endpoint it opens is
# read-only and the button is a demo affordance. A production merchant
# dashboard would authenticate against its own backend instead.
VITE_MERCHANT_KEY=demo-merchant-key

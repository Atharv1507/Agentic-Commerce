VITE_API_BASE_URL=http://localhost:8000

# REQUIRED, and the only variable here with no built-in fallback. Must be the
# MERCHANT's key_id — the same Razorpay account that creates the orders
# (seller-agent/.env RAZORPAY_KEY_ID) — or Razorpay rejects the order_id.
# A key_id is a publishable identifier, not a secret: it only lets the browser
# open a checkout that pays that account. Creating orders, capturing and
# refunding all need the key_SECRET, which stays on the merchant.
# Leave this unset and Razorpay's SDK throws "No key passed" from its
# constructor after injecting its overlay, so the payment window appears to
# flash open and die. Ask us how we know.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# The merchant's own service. Used ONLY by the developer-only merchant
# analytics page — all shopping traffic still goes through the Personal Agent
# above.
VITE_SELLER_BASE_URL=http://localhost:8001

# Reads the merchant's analytics. Note this ships in the client bundle and is
# therefore NOT secret — acceptable only because the endpoint it opens is
# read-only and the button is a demo affordance. A production merchant
# dashboard would authenticate against its own backend instead.
VITE_MERCHANT_KEY=demo-merchant-key

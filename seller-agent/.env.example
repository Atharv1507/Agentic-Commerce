OPENAI_API_KEY=your_openai_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
OPENAI_MODEL=gpt-5-mini
SELLER_AGENT_PORT=8001

# Signing secret for the Razorpay webhook, from Settings -> Webhooks in the
# Razorpay dashboard. Point the webhook at <your_public_url>/razorpay/webhook
# and subscribe: payment_link.paid, order.paid, payment.captured.
#
# THIS IS WHAT MAKES A PAYMENT LINK SETTLE ON ITS OWN. A buyer agent typically
# hands the payment_url to its user and finishes; the user pays later, in a
# browser that agent never sees. Without the webhook the money is captured by
# Razorpay and this shop's ledger keeps the order at `created` until somebody
# opens the merchant dashboard (which reconciles on read as a backstop).
#
# Unlike the API keys below there is NO demo fallback: an unset secret means
# the webhook route refuses every delivery, because an endpoint that books
# revenue must not accept unauthenticated callers.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Which buyer agents may transact with this merchant.
# Format: key:buyer_id,key:buyer_id — the buyer_id is the label that shows up
# in the merchant's revenue-by-buyer-agent breakdown.
#
# BOTH KEYS BELOW ARE OPTIONAL FOR A LOCAL DEMO. Leave them unset and the
# service falls back to the same public demo values, so a fresh clone runs
# end-to-end with no setup — it logs a warning on every boot and reports
# `using_demo_keys: true` on GET /health while it does.
#
# Setting either one replaces the demo value entirely: the demo key then stops
# working. Set both before exposing this service anywhere.
BUYER_API_KEYS=demo-personal-agent-key:personal_agent,demo-external-agent-key:external_demo_agent

# Reads the merchant's own books (GET /merchant/analytics). Deliberately not a
# buyer key — one buyer agent must not be able to see another's contribution.
MERCHANT_API_KEY=demo-merchant-key

# Browser origins allowed to call this service (the analytics dashboard only).
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

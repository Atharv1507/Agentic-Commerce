OPENAI_API_KEY=your_openai_key_here
SELLER_AGENT_URL=http://localhost:8001
OPENAI_MODEL=gpt-5-mini

# Credential this agent presents to the merchant. Must match one of the
# merchant's BUYER_API_KEYS entries. Identifies this buyer agent, scopes its
# session namespace, and attributes the revenue it brings.
SELLER_BUYER_KEY=demo-personal-agent-key

# No RAZORPAY_* keys here on purpose. The merchant owns its own Razorpay
# account and creates every order itself (POST /order on the Seller Agent), so
# a buyer agent never needs — and must never hold — merchant payment
# credentials.
